{% extends 'base.html.twig' %}

{% block title %}Bloom - My Routines{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/myroutines.css') }}">
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        <div class="dashboard-card">

            <div class="dashboard-header">
                <a href="{{ path('app_dashboard') }}" class="btn-dashboard"> ← </a>
                <h1>My Routines</h1>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('app_new_routine') }}" class="btn-create">+ Create a new routine</a>
            </div>

            <div class="dashboard-section">
                <h3 class="section-title today">Today's workout</h3>

                {% if dayRoutines %}
                    <div class="routine-list-container">
                        {% for routine in dayRoutines %}
                            <div class="routine-item-card">
                                <h4>{{ routine.name }}</h4>
                                <ul class="exercise-list">
                                    {% for exercise in routine.exercises %}
                                        <li>{{ exercise.name }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="rest-day-box">
                        No workout planned today. Rest well!
                    </div>
                {% endif %}
            </div>

            <div class="dashboard-section">
                <h3 class="section-title all">My routines</h3>

                <div class="routine-grid-container">
                    {% for routine in allRoutines %}
                        <div class="routine-item-card">
                            <div>
                                <h4>{{ routine.name }}</h4>
                                <ul class="exercise-list">
                                    {% for exercise in routine.exercises %}
                                        <li>{{ exercise.name }}</li>
                                    {% endfor %}
                                </ul>
                            </div>

                            <div class="card-actions-footer">
                                <a href="{{ path('app_edit_routine', {id: routine.id})}}">Edit</a>
                                <form action="{{ path('app_delete_routine', {id: routine.id}) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this routine?');" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ routine.id) }}">
                                    <button type="submit" class="delete-link">Delete</button>
                                    </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
{% endblock %}
