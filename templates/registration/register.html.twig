{% extends 'base.html.twig' %}

{% block title %}Bloom - Register{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-card">

            <div class="login-header">
                <h2>Create an account</h2>
                <p>Join Bloom now for free!</p>
            </div>

            {% if form_errors(registrationForm) %}
                <div class="alert alert-danger" role="alert" aria-live="assertive">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {'attr': {'class': 'auth-form'}}) }}

            <div class="form-group">
                {{ form_label(registrationForm.email, 'Email address') }}
                {{ form_widget(registrationForm.email, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'exemple@domaine.com',
                        'autofocus': 'autofocus'
                    }
                }) }}
                {% if form_errors(registrationForm.email) %}
                    <div class="form-error-msg" role="alert" style="color: #ef4444; font-size: 13px; margin-top: 5px;">
                        {{ form_errors(registrationForm.email) }}
                    </div>
                {% endif %}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.plainPassword, 'Password') }}
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': '••••••••'
                    }
                }) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="form-checkbox">
                {{ form_widget(registrationForm.agreeTerms) }}
                {{ form_label(registrationForm.agreeTerms, "I agree with the terms.") }}
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>

            <button type="submit" class="btn-submit">Register</button>

            <div class="login-footer">
                <p>Already using Bloom? <a href="{{ path('app_login') }}">Login</a></p>
            </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
