{% extends 'base.html.twig' %}

{% block title %}Bloom - Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block body %}

    <div class="dashboard-container">
        <header class="dashboard-header">
            <div class="welcome-text">
                <h1>Nice to see you {{ user.pseudo|default('Some Dude') }} </h1>
                <p>Here's a little look into your day:</p>
            </div>
            <div class="user-badge">
                Level : <span>{{ user.level|capitalize }}</span>
            </div>
        </header>

        <main class="dashboard-grid">
            <div class="dashboard-card status-card">
                <h3>Sleep</h3>
                <p class="card-desc">Your last nights</p>
                <div class="card-content">
                    <span class="main-stat">--</span>
                    <p>Fill your night's data for a few days to see them here!</p>
                </div>
            </div>

            <div class="dashboard-card status-card">
                <h3>Nutrition</h3>
                <p class="card-desc">Your last meals</p>
                <div class="card-content">
                    <p class="empty-text">No meal logged in today.</p>
                </div>
            </div>

            <div class="dashboard-card action-card">
                <h3>My routines</h3>
                <p class="card-desc">Ready for some movement?</p>
                <div class="card-actions">
                    <a href="#" class="btn-dashboard">Create a routine</a>
                    <a href="#" class="btn-dashboard btn-secondary">Start a workout</a>
                </div>
            </div>
        </main>
    </div>

{% endblock %}
