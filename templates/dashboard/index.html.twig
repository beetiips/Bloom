{% extends 'base.html.twig' %}

{% block title %}Bloom - Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block body %}

    <div class="dashboard-container">
        <header class="dashboard-header">
            <div class="welcome-text">
                <h1>Nice to see you {{ user.pseudo|default('Philibert') }} </h1>
                <p>Here's a little look into your day:</p>
            </div>
        </header>

        <main class="dashboard-grid">
            <div class="dashboard-card status-card">
                <h3>Sleep</h3>
                <p class="card-desc">Your last nights</p>
                <div class="card-content">
                    <span class="main-stat">No nights yet</span>
                    <p>Fill your night's data for a few days to see them here!</p>
                </div>
            </div>

            <div class="dashboard-card status-card">
                <h3>Nutrition</h3>
                <p class="card-desc">Your last meals</p>
                <div class="card-content">
                    <p class="empty-text">No meal logged in today.</p>
                </div>
            </div>

            <div class="dashboard-card action-card">
                <h3>Today's workout routine</h3>
                <p class="card-desc">Ready for some movement?</p>
                {% if dayRoutines %}
                    <div class="routine-list-container">
                        {% for routine in dayRoutines %}
                            <div class="routine-item-card">
                                <h4>{{ routine.name }}</h4>
                                <ul class="exercise-list">
                                    {% for exercise in routine.exercises %}
                                        <li>{{ exercise.name }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="rest-day-box">
                        No workout planned today. Rest well!
                    </div>
                {% endif %}
                <div class="card-actions">
                    <a href="{{ path('app_workout_routine') }}" class="btn-dashboard">See all routines</a>
                    <a href="{{ path('app_new_routine') }}" class="btn-dashboard">Create a routine</a>
                    <a href="?" class="btn-dashboard btn-secondary">Start a workout</a>
                </div>
            </div>
        </main>
    </div>

{% endblock %}
