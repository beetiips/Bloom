{% extends 'base.html.twig' %}

{% block title %}Page not found - Bloom{% endblock %}

{% block body %}
    <div class="dashboard-container" style="text-align: center; padding: 60px 20px;">
        <div class="dashboard-card" style="max-width: 500px; margin: 0 auto;">
            <h1 style="font-size: 72px; color: var(--primary-color, #3b82f6); margin-bottom: 10px;">404</h1>
            <h2>Oops! This page rose somewhere else.</h2>
            <p style="color: var(--text-muted); margin: 20px 0;">
                The workout or routine you are looking for doesn't exist or has been moved.
            </p>
            <a href="{{ path('app_dashboard') }}" class="btn-create" style="display: inline-block; text-decoration: none;">
                Back to Dashboard
            </a>
        </div>
    </div>
{% endblock %}
